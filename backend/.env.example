# PostgreSQL connection string (Neon, Supabase, Render Postgres, or local Postgres all work)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Secrets used to sign JWT access/refresh tokens.
# Generate strong values with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# Port the NestJS server listens on
PORT=4000
